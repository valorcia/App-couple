# ---- Général ----
NODE_ENV=development
APP_NAME="Entre Nous"
API_PORT=4000
API_PUBLIC_URL=http://localhost:4000
WEB_PUBLIC_URL=http://localhost:3000
ADMIN_PUBLIC_URL=http://localhost:3100
CORS_ORIGINS=http://localhost:3000,http://localhost:3100

# ---- Base de données / cache ----
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/appcouple
REDIS_URL=redis://127.0.0.1:6379

# ---- Sécurité (générer avec: openssl rand -base64 48) ----
JWT_SECRET=change-me-with-a-long-random-secret-of-at-least-32-chars
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
# 32 octets en base64 (openssl rand -base64 32)
DATA_ENCRYPTION_KEY=change-me-base64-32-bytes-key-aaaaaaaaaaaaaaaaaaa=
COOKIE_SECURE=false

# ---- E-mail (provider: console | smtp | resend) ----
MAIL_PROVIDER=console
MAIL_FROM="Entre Nous <no-reply@example.com>"
SMTP_URL=
RESEND_API_KEY=

# ---- IA (provider: anthropic | openai-compatible | disabled) ----
AI_PROVIDER=disabled
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=

# ---- Paiements ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
REVENUECAT_WEBHOOK_SECRET=

# ---- Stockage objet (S3 compatible) ----
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ---- Push ----
EXPO_ACCESS_TOKEN=

# ---- Front ----
NEXT_PUBLIC_API_URL=http://localhost:4000

# Désactive le rate limiting (e2e locaux uniquement, refusé en production)
RATE_LIMIT_DISABLED=false
