{
  "name": "@couple/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node --watch -r @swc-node/register -r dotenv/config src/main.ts dotenv_config_path=../../.env",
    "start": "node -r @swc-node/register src/main.ts",
    "worker": "WORKER_MODE=true node -r @swc-node/register src/main.ts",
    "build": "swc src -d dist --strip-leading-paths --config-file .swcrc",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src test",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@couple/database": "workspace:*",
    "@couple/shared": "workspace:*",
    "@couple/types": "workspace:*",
    "@couple/validation": "workspace:*",
    "@nestjs/common": "11.2.8",
    "@nestjs/core": "11.2.8",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/platform-express": "11.2.8",
    "@nestjs/platform-socket.io": "11.2.8",
    "@nestjs/swagger": "11.4.7",
    "@nestjs/websockets": "11.2.8",
    "@swc-node/register": "^1.12.0",
    "@swc/core": "^1.16.0",
    "argon2": "^0.45.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.0.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.11.0",
    "nestjs-pino": "^4.6.0",
    "nodemailer": "^7.0.0",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "pino-pretty": "^13.2.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.4",
    "zod": "^4.1.0",
    "rrule": "^2.8.1",
    "@socket.io/redis-adapter": "^8.3.0",
    "@couple/game-engine": "workspace:*",
    "@couple/ai": "workspace:*",
    "stripe": "^23.0.0",
    "bullmq": "^5.60.0"
  },
  "devDependencies": {
    "@couple/config": "workspace:*",
    "@nestjs/testing": "11.2.8",
    "@swc/cli": "^0.7.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.0",
    "@types/node": "^22.20.0",
    "@types/nodemailer": "^7.0.0",
    "@types/supertest": "^6.0.0",
    "eslint": "^9.39.0",
    "supertest": "^7.1.0",
    "typescript": "5.9.3",
    "unplugin-swc": "^2.0.0",
    "vitest": "^4.0.0",
    "socket.io-client": "^4.8.4"
  }
}
