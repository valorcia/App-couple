{
  "expo": {
    "name": "Entre Nous",
    "slug": "entre-nous",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "entrenous",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": { "supportsTablet": false, "bundleIdentifier": "com.entrenous.app" },
    "android": { "package": "com.entrenous.app", "adaptiveIcon": { "backgroundColor": "#F8F3EC" } },
    "web": { "bundler": "metro", "output": "static" },
    "plugins": ["expo-router", "expo-secure-store", "expo-localization", ["expo-splash-screen", { "backgroundColor": "#F8F3EC" }]],
    "experiments": { "typedRoutes": true },
    "extra": { "apiUrl": "http://localhost:4000", "revenuecat": { "ios": "", "android": "" } }
  }
}
