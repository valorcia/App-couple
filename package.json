{
  "name": "entre-nous",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @couple/database generate",
    "db:migrate": "pnpm --filter @couple/database migrate:deploy",
    "db:migrate:dev": "pnpm --filter @couple/database migrate:dev",
    "db:seed": "pnpm --filter @couple/database seed",
    "db:studio": "pnpm --filter @couple/database studio",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,css}\""
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "turbo": "^2.5.6",
    "typescript": "5.9.3"
  }
}
